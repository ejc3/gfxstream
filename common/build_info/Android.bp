package {
    default_applicable_licenses: ["hardware_google_gfxstream_license"],
}

cc_library_headers {
    name: "libgfxstream_common_build_info_headers",
    vendor_available: true,
    host_supported: true,
    export_include_dirs: [
        "include",
    ],
    apex_available: [
        "//apex_available:platform",
        "com.android.virt",
    ],
}

cc_library_static {
    name: "libgfxstream_common_build_info",
    vendor_available: true,
    host_supported: true,
    header_libs: [
        "libgfxstream_common_build_info_headers",
    ],
    export_header_lib_headers: [
        "libgfxstream_common_build_info_headers",
    ],
    srcs: [
        "build_info.cpp",
    ],
    apex_available: [
        "//apex_available:platform",
        "com.android.virt",
    ],
    static_libs: [
        "libbuildversion",
    ],
    use_version_lib: true,
    cflags: [
        "-DGFXSTREAM_BUILD_INFO_USE_ANDROID_LIBBUILDVERSION=1",
    ],
}
